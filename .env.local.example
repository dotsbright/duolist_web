# duolist_web — site, account deletion, admin console (skeleton)
# Copy to `.env.local`, fill in real values. The real file is gitignored.

# Public base URL used inside email links and the Vercel deployment.
BASE_URL=https://duolist.dotsbright.com

# Secret used to sign delete-confirmation JWTs (long and random).
DELETE_JWT_SECRET=change-me

# SMTP for the confirmation email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=change-me
SMTP_FROM=Duolist <no-reply@example.com>

# Optional: where confirmed deletions are reported.
SUPPORT_TO=contact@example.com

# Firebase Admin service account JSON on a single line (escaped newlines).
# Leave empty to fall back to Application Default Credentials.
FIREBASE_ADMIN_JSON=
